{
  "name": "discord-bot-client",
  "productName": "DiscordBotClient",
  "version": "3.9.3",
  "description": "DiscordBotClient - login into discord with a bot token",
  "author": {
    "name": "aiko-chan-ai",
    "email": "aiko@shiroko.onmicrosoft.com"
  },
  "repository": {
    "url": "https://github.com/aiko-chan-ai/DiscordBotClient/"
  },
  "license": "GPL-3.0",
  "main": "build/index.js",
  "scripts": {
    "test": "node --test tests/electron.test.cjs && npm run test:plugin",
    "test:plugin": "tsx --test tests/plugin/*.test.ts",
    "test:app": "npm run build:ts && npm run start",
    "test:app:vc": "npm run vencord && npm run build:ts && npm run start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json && tsc --ignoreConfig --noEmit --strict --skipLibCheck --target es2024 --module NodeNext tests/settings-types.ts",
    "build:ts": "tsc && tsc-alias && npm run build:settings",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "vencord": "tsx scripts/vencordBuild.ts",
    "discohook": "tsx scripts/discohookBuild.ts",
    "core:update": "tsx scripts/update.ts",
    "start": "electron .",
    "mac": "electron-builder -m --publish never",
    "win": "electron-builder -w --publish never",
    "linux": "electron-builder -l --publish never",
    "build:bin": "electron-builder --publish never",
    "build": "npm run build:deps && npm run build:ts && npm run build:bin",
    "build:deps": "npm run vencord && npm run discohook",
    "requirement": "npm ci && tsx scripts/vencordClone.ts && tsx scripts/discohookClone.ts",
    "build:settings": "tsc -p tsconfig.renderer.json && vite build --config scripts/settingsVite.mts"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-components": "^9.75.3",
    "@fluentui/react-icons": "^2.0.347",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/ini": "^4.1.1",
    "@types/js-beautify": "^1.14.3",
    "@types/jsdom": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.7",
    "@types/probe-image-size": "^7.2.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-header": "^1.2.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "js-beautify": "^2.0.3",
    "jsdom": "^31.0.1",
    "pnpm": "^12.23.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@sapphire/snowflake": "^4.0.0",
    "dexie": "^4.4.7",
    "discord-api-types": "^0.38.60",
    "discord-protos": "^1.2.429",
    "electron-context-menu": "^5.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "ini": "^7.0.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "murmurhash": "^2.0.1",
    "probe-image-size": "^7.5.0",
    "selfsigned": "^5.5.0",
    "undici": "^8.13.1"
  },
  "build": {
    "files": [
      "!docs",
      "!scripts",
      "!Vencord",
      "!src",
      "!tsconfig.json",
      "!tsup.config.ts",
      "!.eslintrc.json",
      "!.gitattributes",
      "!.gitignore",
      "!.prettierrc.json",
      "!eslint.config.mjs",
      "!readme.md",
      "assets",
      "assets/editor",
      "build",
      "VencordExtension",
      "!tsconfig.renderer.json",
      "!plans",
      "!plugin"
    ],
    "appId": "DiscordBotClient",
    "productName": "DiscordBotClient",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 aiko-chan-ai",
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "icon": "./assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs access to the microphone",
        "com.apple.security.device.audio-input": true
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "DiscordBotClient",
          "GenericName": "Internet Messenger",
          "Type": "Application",
          "Categories": "Network;InstantMessaging;Chat;",
          "Keywords": "discord;bot;vencord;electron;chat;"
        }
      },
      "category": "Network",
      "icon": "./assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "./assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "./LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pealz1",
        "repo": "DiscordBotClient"
      }
    ],
    "asar": false
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.9"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.9"
    },
    "js-beautify": {
      "glob": "^14.0.2"
    },
    "editorconfig": {
      "minimatch": "^11.0.9"
    }
  }
}
